# --- AI ---
OPENROUTER_API_KEY=your_openrouter_api_key
AI_MODEL=openrouter/free

# --- eBay (production keys from developer.ebay.com) ---
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
# One-time user refresh token (valid ~18 months). See README notes.
EBAY_REFRESH_TOKEN=your_ebay_refresh_token
EBAY_MARKETPLACE=EBAY_GB
EBAY_CURRENCY=GBP
EBAY_LANG=en-GB
# Business policy IDs + inventory location (create in Seller Hub / via API)
EBAY_FULFILLMENT_POLICY=your_fulfillment_policy_id
EBAY_PAYMENT_POLICY=your_payment_policy_id
EBAY_RETURN_POLICY=your_return_policy_id
EBAY_LOCATION_KEY=your_inventory_location_key
